# CityMood API 环境配置

# 环境: development | production
NODE_ENV=development

# 服务器端口
PORT=3000

# CORS 配置
CORS_ORIGIN=*

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=citymood
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_SIZE=10
DB_SSL=false

# 日志级别: debug | info | warn | error
LOG_LEVEL=debug
